# Generated by Bento for app {{.Slug}} ({{.AppID}}). Only Bento-internal,
# config-owned tasks appear here; user jobs and workers live in the app's own
# minicrond registry and are never copied into Bento state.
[server]
tcp_enabled = false
unix_socket = true

[scheduler]
timezone = "UTC"
# Bare argv names (argv = ["php", ...]) resolve here. The toolchains of the
# official runtime images live in /usr/local/bin; minicrond's default is only
# /usr/bin and /bin.
trusted_path = ["/usr/local/bin", "/usr/bin", "/bin"]

# Filled into jobs and workers saved through the scheduler UI or imported.
# minicrond's own default is a clean environment, which hides the toolchain's
# PATH and the app's DB_*/REDIS_* credentials, so `php artisan schedule:run`
# would fail.
[defaults]
env_base = "inherit"
working_dir = "~/app"
{{range .Jobs}}
[[job]]
name = "{{.Name}}"
schedule = "{{.Schedule}}"
argv = [{{range $i, $a := .Argv}}{{if $i}}, {{end}}{{printf "%q" $a}}{{end}}]
timeout = {{.Timeout}}
{{end -}}
