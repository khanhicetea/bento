{{/* App-local Nginx for one PHP app. Runs as the app UID on :8080. */ -}}
# Generated by Bento for app {{.Slug}} ({{.AppID}}). Do not edit; changes are overwritten.
worker_processes {{.Workers}};
pid /run/nginx/nginx.pid;
error_log stderr warn;

events {
  worker_connections 1024;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  server_tokens off;
  sendfile on;
  tcp_nopush on;
  # Must stay above the edge upstream keepalive_timeout (25s).
  keepalive_timeout 30s;
  # Short validity: release-symlink deploys must be seen within seconds.
  open_file_cache max=2000 inactive=30s;
  open_file_cache_valid 10s;
  open_file_cache_errors on;
  client_body_timeout 60s;
  client_header_timeout 15s;
  send_timeout 60s;
  client_max_body_size {{.UploadLimitMB}}m;
  client_body_temp_path /tmp/nginx/body;
  proxy_temp_path /tmp/nginx/proxy;
  fastcgi_temp_path /tmp/nginx/fastcgi;
  uwsgi_temp_path /tmp/nginx/uwsgi;
  scgi_temp_path /tmp/nginx/scgi;

  log_format bento '$remote_addr - [$time_local] "$request" $status $body_bytes_sent '
                   '"$http_referer" "$http_user_agent" rt=$request_time app={{.Slug}} host=$host';
{{- if .AccessLog}}
  access_log /dev/stdout bento;
{{- else}}
  access_log off;
{{- end}}

  # Forwarding headers are trusted only from Bento-owned ingress addresses.
{{- range .TrustedProxies}}
  set_real_ip_from {{.}};
{{- end}}
{{- if .TrustedProxies}}
  real_ip_header X-Forwarded-For;
{{- end}}
  geo $realip_remote_addr $bento_trusted_proxy {
    default 0;
{{- range .TrustedProxies}}
    {{.}} 1;
{{- end}}
  }
  map "$bento_trusted_proxy:$http_x_forwarded_proto" $bento_https {
    default "";
    "1:https" on;
  }

  # Browser caching for static files. Only URLs that change when the content
  # changes are cached long: a query string (?v=, ?id=, ?ver=) or a
  # fingerprinted name (main.3f2a9c1d.js, app-B7x9kQ2a.css: 8+ name characters
  # including a digit after "." or "-"). Anything else is cached briefly, so an
  # unversioned asset changed by a deploy is seen within minutes.
  map "$is_args$uri" $bento_static_cache {
    default "public, max-age=600";
    "~^\?" "public, max-age=31536000, immutable";
    "~[.-](?=[A-Za-z_]*[0-9])[A-Za-z0-9_]{8,}(?:\.[A-Za-z0-9]+)+$" "public, max-age=31536000, immutable";
  }

  upstream bento_php {
    server unix:/run/php/fpm.sock;
  }

  server {
    listen {{.Port}} default_server;
    root {{.DocumentRoot}};
    index index.php index.html;
    charset utf-8;
    # Redirects nginx makes itself (a directory without its trailing slash)
    # stay relative: an absolute one would name this :{{.Port}} over http.
    absolute_redirect off;
{{- if eq .Routing "front-controller"}}
    # Set to 0 only for static-looking URLs answered by PHP (see @bento_php_static).
    set $bento_edge_expires "";
{{- end}}

    # Refuse symlink traversal below the document root (the explicitly
    # configured release symlink, if any, lies before the checked part).
    disable_symlinks on from={{.SymlinkFrom}};

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt { access_log off; log_not_found off; }

{{- if .Protection}}

{{.Protection}}
{{- end}}

    location ~* \.(?:css|js|mjs|map|jpg|jpeg|gif|png|svg|ico|webp|avif|woff|woff2|ttf|eot|webmanifest)$ {
      add_header Cache-Control $bento_static_cache;
      access_log off;
{{- if eq .Routing "front-controller"}}
      try_files $uri @bento_php_static;
{{- else}}
      try_files $uri =404;
{{- end}}
    }
{{- if eq .Routing "front-controller"}}

    # A static-looking URL with no file behind it is a route (a generated
    # /js/lang.js, an /og-image.png). The edge's opt-in static cache ignores
    # Cache-Control from apps, so X-Accel-Expires: 0 keeps these responses,
    # which may be per-user, out of it. The edge strips the header.
    location @bento_php_static {
      set $bento_edge_expires 0;
      rewrite ^ /index.php last;
    }

    location / {
      try_files $uri $uri/ /index.php$is_args$args;
    }

    location ~ ^/index\.php(/|$) {
      fastcgi_split_path_info ^(/index\.php)(/.*)$;
      add_header X-Accel-Expires $bento_edge_expires always;
      include /etc/bento/fastcgi.conf;
    }

    location ~ \.php(/|$) {
      return 404;
    }
{{- else}}

    location / {
      try_files $uri $uri/ =404;
    }

    location ~ [^/]\.php(/|$) {
      fastcgi_split_path_info ^(.+?\.php)(/.*)$;
      try_files $fastcgi_script_name =404;
      include /etc/bento/fastcgi.conf;
    }
{{- end}}
  }

  # Private readiness listener for FPM, reachable only inside the container.
  server {
    listen 127.0.0.1:8081;
    access_log off;
    location = /fpm-ping {
      include /etc/nginx/fastcgi_params;
      fastcgi_param SCRIPT_NAME /fpm-ping;
      fastcgi_param SCRIPT_FILENAME /fpm-ping;
      fastcgi_pass bento_php;
    }
    location / {
      return 404;
    }
  }
}
