# Generated by Bento. FastCGI parameters for app {{.Slug}}.
include /etc/nginx/fastcgi_params;
set $bento_path_info $fastcgi_path_info;
fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
fastcgi_param DOCUMENT_ROOT $realpath_root;
fastcgi_param PATH_INFO $bento_path_info;
fastcgi_param HTTPS $bento_https if_not_empty;
fastcgi_param HTTP_PROXY "";
fastcgi_read_timeout 120s;
fastcgi_pass bento_php;
