; Generated by Bento for app {{.Slug}} ({{.AppID}}). One app-owned pool; the
; master and workers both run as uid {{.UID}} (no root master).
[global]
pid = /run/php/php-fpm.pid
error_log = /proc/self/fd/2
log_limit = 8192
daemonize = no

[{{.Slug}}]
listen = /run/php/fpm.sock
listen.mode = 0600
; Ondemand: workers fork per request and exit after {{.PHP.IdleTimeout}} idle, so an idle
; app holds none. max_children is sized from the app memory limit, which FPM
; shares with nginx, cron jobs and workers.
pm = ondemand
pm.max_children = {{.PHP.Workers}}
pm.process_idle_timeout = {{.PHP.IdleTimeout}}
pm.max_requests = 1000
ping.path = /fpm-ping
ping.response = pong
clear_env = no
catch_workers_output = yes
decorate_workers_output = no
request_slowlog_timeout = 5s
slowlog = /proc/self/fd/2
php_admin_value[open_basedir] = {{.OpenBasedir}}
php_admin_value[session.save_path] = {{.Home}}/tmp/sessions
php_admin_value[upload_tmp_dir] = /tmp
php_admin_value[upload_max_filesize] = {{.UploadLimitMB}}M
php_admin_value[post_max_size] = {{.UploadLimitMB}}M
; Web request limits. php_value, not php_admin_value: the app may still raise
; them for itself with ini_set() or .user.ini.
php_value[memory_limit] = {{.PHP.WebMemoryLimitMB}}M
php_value[max_execution_time] = {{.PHP.MaxExecutionSeconds}}
php_value[max_input_vars] = {{.PHP.MaxInputVars}}
