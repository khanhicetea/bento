# {{.Kind}} {{.Name}}{{if .Unavailable}} (published; app currently unavailable){{end}}
{{- if .AppUpstream}}
# Upstream {{.UpstreamName}} is shared by every host of the app (upstreams/).
{{- end}}
{{- if .ProxyUpstreams}}
# Names are resolved at run time through the http-level resolver (resolve):
# a name that does not resolve yet gives this host 502s instead of failing
# the whole edge config, and changed addresses are picked up.
upstream {{.UpstreamName}} {
  zone {{.UpstreamName}} 64k;
{{- range .ProxyUpstreams}}
  server {{.}} resolve;
{{- end}}
  keepalive 32;
}
{{- end}}
{{- define "bento-proxy"}}
    proxy_http_version 1.1;
    # Security-relevant forwarding headers are overwritten, never appended.
    # $remote_addr, $bento_proto and $bento_port are the visitor's when the
    # request came through the tunnel; $bento_forwarded_host carries the
    # edge's published port when it is not standard (edge-nginx.conf).
{{- if .UpstreamTLSName}}
    # An HTTPS upstream named by DNS is reached as that name: SNI, the
    # certificate check and Host all use it. X-Forwarded-Host keeps the
    # visitor's host.
    proxy_set_header Host {{.UpstreamHostHeader}};
{{- else}}
    proxy_set_header Host $bento_forwarded_host;
{{- end}}
    proxy_set_header X-Real-IP {{.ClientAddr}};
    proxy_set_header X-Forwarded-For {{.ClientAddr}};
    proxy_set_header X-Forwarded-Host $bento_forwarded_host;
    proxy_set_header X-Forwarded-Proto $bento_proto;
    proxy_set_header X-Forwarded-Port $bento_port;
    proxy_set_header Forwarded "";
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_connect_timeout 5s;
    proxy_send_timeout 300s;
    proxy_read_timeout 300s;
    proxy_request_buffering off;
{{- if eq .UpstreamScheme "https"}}
    proxy_ssl_protocols TLSv1.2 TLSv1.3;
    proxy_ssl_session_reuse on;
{{- if .UpstreamTLSName}}
    proxy_ssl_server_name on;
    proxy_ssl_name {{.UpstreamTLSName}};
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 4;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
{{- else}}
    # Named by an IP address: encrypted, but the certificate is not verified.
    proxy_ssl_verify off;
{{- end}}
{{- end}}
{{- end}}
{{- define "bento-location"}}
  set $bento_route "{{.Name}}";
{{- if .AccessLog}}
  access_log /dev/stdout bento_edge;
{{- end}}
{{- if .TrafficLog}}
  access_log {{.TrafficLog}} bento_traffic if=$bento_traffic;
{{- end}}
  client_max_body_size {{.MaxBodyMB}}m;
{{- range .Includes}}
  include /etc/bento-edge-custom/routes/{{.}}/*.conf;
{{- end}}
{{- if .UtilsUpstream}}
  # Bento's utils routes (webhooks) go to the backend's utils listener,
  # never to the upstream.
  location ^~ /_bento/webhook/ {
    client_max_body_size 8m;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP {{.ClientAddr}};
    proxy_set_header X-Forwarded-For {{.ClientAddr}};
    proxy_set_header X-Forwarded-Proto $bento_proto;
    proxy_set_header Forwarded "";
    proxy_set_header Connection "";
    proxy_connect_timeout 3s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;
    proxy_pass http://bento_utils;
  }
{{- end}}
{{- if .Protection}}
{{.Protection}}
{{- end}}
{{- if .StaticCache}}
  # Static-extension responses are served from the edge cache. Opting in
  # asserts they are not per-user. PHP apps serve them from disk; one answered
  # by the app's front controller carries X-Accel-Expires: 0 and is not stored.
  location ~* \.(?:css|js|mjs|map|jpg|jpeg|gif|png|svg|ico|webp|avif|woff|woff2|ttf|eot|webmanifest)$ {
    proxy_cache bento_static;
    proxy_cache_key "{{.Name}}$host$request_uri";
{{- if .AppUpstream}}
    # Edge TTL is short and independent of the app's 30d browser Expires so a
    # deploy that changes an unversioned asset is picked up within minutes.
    proxy_ignore_headers Cache-Control Expires;
{{- else}}
    # External upstreams are trusted only for what they mark cacheable:
    # Cache-Control private/no-store/no-cache and Set-Cookie responses are
    # never stored; the 10m default applies when no freshness is given.
{{- end}}
    proxy_cache_valid 200 10m;
    proxy_cache_valid 404 1m;
    proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
    proxy_cache_background_update on;
    proxy_cache_lock on;
    proxy_cache_bypass $http_authorization;
    proxy_no_cache $http_authorization;
    # Any add_header here would drop the server's (Alt-Svc, a drop-in's
    # HSTS) on cached assets; merge keeps them.
    add_header_inherit merge;
    add_header X-Bento-Cache $upstream_cache_status always;
{{- template "bento-proxy" .}}
{{- if .UpstreamURI}}
    # A regex location cannot give proxy_pass a URI; map "/" onto the
    # upstream path exactly as location / does.
    rewrite ^/(.*)$ {{.UpstreamURI}}$1 break;
{{- end}}
    proxy_pass {{.UpstreamScheme}}://{{.UpstreamName}};
  }
{{- end}}
  location / {
{{- template "bento-proxy" .}}
    proxy_pass {{.UpstreamScheme}}://{{.UpstreamName}}{{.UpstreamURI}};
  }
{{- end}}

{{- define "bento-front-reject"}}
{{- if .FrontHTTPPort}}
  # PROXY protocol listeners accept only the trusted front proxy.
  if ($bento_front_reject) {
    return 444;
  }
{{- end}}
{{- end}}

{{- define "bento-redirect"}}
  set $bento_route "{{.Name}}";
{{- if .AccessLog}}
  access_log /dev/stdout bento_edge;
{{- end}}
{{- if .TrafficLog}}
  access_log {{.TrafficLog}} bento_traffic if=$bento_traffic;
{{- end}}
{{- range .Includes}}
  include /etc/bento-edge-custom/routes/{{.}}/*.conf;
{{- end}}
  location / {
    return 301 {{.RedirectURL}}$request_uri;
  }
{{- end}}

server {
  listen 80;
  listen [::]:80;
{{- if .FrontHTTPPort}}
  listen {{.FrontHTTPPort}} proxy_protocol;
  listen [::]:{{.FrontHTTPPort}} proxy_protocol;
{{- end}}
  server_name {{.ServerNames}};
{{- template "bento-front-reject" .}}
{{- if .RedirectURL}}
{{- template "bento-redirect" .}}
{{- else if .Redirect}}
  # A tunnel visitor already on HTTPS is served here; redirecting would loop.
  if ($bento_proto = http) {
    set $bento_route "{{.Name}}";
    return 301 https://$host$bento_https_suffix$request_uri;
  }
{{- template "bento-location" .}}
{{- else}}
{{- template "bento-location" .}}
{{- end}}
}
{{- if .TLS}}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
{{- if .FrontHTTPSPort}}
  listen {{.FrontHTTPSPort}} ssl proxy_protocol;
  listen [::]:{{.FrontHTTPSPort}} ssl proxy_protocol;
{{- end}}
{{- if .HTTP3}}
  listen 443 quic;
  listen [::]:443 quic;
{{- if .FrontHTTPSPort}}
  add_header Alt-Svc $bento_alt_svc always;
{{- else}}
  add_header Alt-Svc 'h3=":{{.HTTPSAdvertisedPort}}"; ma=86400' always;
{{- end}}
{{- end}}
  http2 on;
  server_name {{.ServerNames}};
{{- template "bento-front-reject" .}}
{{- if .ACME}}
  acme_certificate bento_acme;
  ssl_certificate $bento_acme_certificate;
  ssl_certificate_key $bento_acme_certificate_key;
  ssl_certificate_cache max=10;
{{- else}}
  ssl_certificate {{.CertFile}};
  ssl_certificate_key {{.KeyFile}};
{{- end}}
{{- if .RedirectURL}}
{{- template "bento-redirect" .}}
{{- else}}
{{- template "bento-location" .}}
{{- end}}
}
{{- end}}
