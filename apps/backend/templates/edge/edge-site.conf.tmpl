# {{.Kind}} {{.Name}}{{if .Unavailable}} (published; app currently unavailable){{end}}
{{- if .AppUpstream}}
# Upstream {{.UpstreamName}} is shared by every host of the app (upstreams/).
{{- end}}
{{- if .ProxyUpstreams}}
upstream {{.UpstreamName}} {
{{- range .ProxyUpstreams}}
  server {{.}};
{{- end}}
  keepalive 32;
}
{{- end}}
{{- define "bento-proxy"}}
    proxy_http_version 1.1;
    # Security-relevant forwarding headers are overwritten, never appended.
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_set_header Forwarded "";
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_connect_timeout 5s;
    proxy_send_timeout 300s;
    proxy_read_timeout 300s;
    proxy_request_buffering off;
{{- end}}
{{- define "bento-location"}}
  set $bento_route "{{.Name}}";
{{- if .AccessLog}}
  access_log /dev/stdout bento_edge;
{{- end}}
  client_max_body_size {{.MaxBodyMB}}m;
{{- range .Includes}}
  include /etc/bento-edge-custom/routes/{{.}}/*.conf;
{{- end}}
{{- if .UtilsUpstream}}
  # Bento's utils routes (webhooks) go to the backend's utils listener,
  # never to the upstream.
  location ^~ /_bento/webhook/ {
    client_max_body_size 8m;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Forwarded "";
    proxy_set_header Connection "";
    proxy_connect_timeout 3s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;
    proxy_pass http://bento_utils;
  }
{{- end}}
{{- if .StaticCache}}
  # Static-extension responses are served from the edge cache. Opting in
  # asserts they are not per-user (PHP apps serve them from disk, never PHP).
  location ~* \.(?:css|js|mjs|map|jpg|jpeg|gif|png|svg|ico|webp|avif|woff|woff2|ttf|eot|webmanifest)$ {
    proxy_cache bento_static;
    proxy_cache_key "{{.Name}}$host$request_uri";
{{- if .AppUpstream}}
    # Edge TTL is short and independent of the app's 30d browser Expires so a
    # deploy that changes an unversioned asset is picked up within minutes.
    proxy_ignore_headers Cache-Control Expires;
{{- else}}
    # External upstreams are trusted only for what they mark cacheable:
    # Cache-Control private/no-store/no-cache and Set-Cookie responses are
    # never stored; the 10m default applies when no freshness is given.
{{- end}}
    proxy_cache_valid 200 10m;
    proxy_cache_valid 404 1m;
    proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
    proxy_cache_background_update on;
    proxy_cache_lock on;
    proxy_cache_bypass $http_authorization;
    proxy_no_cache $http_authorization;
    add_header X-Bento-Cache $upstream_cache_status always;
{{- template "bento-proxy" .}}
{{- if .UpstreamURI}}
    # A regex location cannot give proxy_pass a URI; map "/" onto the
    # upstream path exactly as location / does.
    rewrite ^/(.*)$ {{.UpstreamURI}}$1 break;
{{- end}}
    proxy_pass {{.UpstreamScheme}}://{{.UpstreamName}};
  }
{{- end}}
  location / {
{{- template "bento-proxy" .}}
    proxy_pass {{.UpstreamScheme}}://{{.UpstreamName}}{{.UpstreamURI}};
  }
{{- end}}

{{- define "bento-redirect"}}
  set $bento_route "{{.Name}}";
{{- if .AccessLog}}
  access_log /dev/stdout bento_edge;
{{- end}}
{{- range .Includes}}
  include /etc/bento-edge-custom/routes/{{.}}/*.conf;
{{- end}}
  location / {
    return 301 {{.RedirectURL}}$request_uri;
  }
{{- end}}

server {
  listen 80;
  listen [::]:80;
  server_name {{.ServerNames}};
{{- if .RedirectURL}}
{{- template "bento-redirect" .}}
{{- else if .Redirect}}
  set $bento_route "{{.Name}}";
  location / {
    return 301 https://$host{{.HTTPSPortSuffix}}$request_uri;
  }
{{- else}}
{{- template "bento-location" .}}
{{- end}}
}
{{- if .TLS}}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
{{- if .HTTP3}}
  listen 443 quic;
  listen [::]:443 quic;
  add_header Alt-Svc 'h3=":{{.HTTPSAdvertisedPort}}"; ma=86400' always;
{{- end}}
  http2 on;
  server_name {{.ServerNames}};
{{- if .ACME}}
  acme_certificate bento_acme;
  ssl_certificate $acme_certificate;
  ssl_certificate_key $acme_certificate_key;
  ssl_certificate_cache max=10;
{{- else}}
  ssl_certificate {{.CertFile}};
  ssl_certificate_key {{.KeyFile}};
{{- end}}
{{- if .RedirectURL}}
{{- template "bento-redirect" .}}
{{- else}}
{{- template "bento-location" .}}
{{- end}}
}
{{- end}}
