# {{.Kind}} {{.Name}}{{if .Unavailable}} (published; app currently unavailable){{end}}
{{- if .ProxyUpstreams}}
upstream {{.UpstreamName}} {
{{- range .ProxyUpstreams}}
  server {{.}};
{{- end}}
  keepalive 32;
}
{{- end}}
{{- define "bento-location"}}
  set $bento_route "{{.Name}}";
{{- if .AccessLog}}
  access_log /dev/stdout bento_edge;
{{- end}}
  client_max_body_size {{.MaxBodyMB}}m;
  include /etc/bento-edge-custom/routes/{{.Name}}/*.conf;
{{- if .PublicUpstream}}
  # Bento's public routes (webhooks) go to the backend's public listener,
  # never to the upstream.
  location ^~ /_webhook/ {
    client_max_body_size 8m;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Forwarded "";
    proxy_set_header Connection "";
    proxy_connect_timeout 3s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;
    proxy_pass http://{{.PublicUpstream}};
  }
{{- end}}
  location / {
    proxy_http_version 1.1;
    # Security-relevant forwarding headers are overwritten, never appended.
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_set_header Forwarded "";
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_connect_timeout 5s;
    proxy_send_timeout 300s;
    proxy_read_timeout 300s;
    proxy_request_buffering off;
{{- if .AppUpstream}}
    set $bento_upstream {{.AppUpstream}};
    proxy_pass $bento_upstream;
{{- else}}
    proxy_pass {{.UpstreamScheme}}://{{.UpstreamName}}{{.UpstreamURI}};
{{- end}}
  }
{{- end}}

server {
  listen 80;
  listen [::]:80;
  server_name {{.ServerNames}};
{{- if .Redirect}}
  set $bento_route "{{.Name}}";
  location / {
    return 301 https://$host{{.HTTPSPortSuffix}}$request_uri;
  }
{{- else}}
{{- template "bento-location" .}}
{{- end}}
}
{{- if .TLS}}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
{{- if .HTTP3}}
  listen 443 quic;
  listen [::]:443 quic;
  add_header Alt-Svc 'h3=":{{.HTTPSAdvertisedPort}}"; ma=86400' always;
{{- end}}
  http2 on;
  server_name {{.ServerNames}};
{{- if .ACME}}
  acme_certificate bento_acme;
  ssl_certificate $acme_certificate;
  ssl_certificate_key $acme_certificate_key;
  ssl_certificate_cache max=10;
{{- else}}
  ssl_certificate {{.CertFile}};
  ssl_certificate_key {{.KeyFile}};
{{- end}}
{{- template "bento-location" .}}
}
{{- end}}
