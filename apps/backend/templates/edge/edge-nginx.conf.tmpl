# Generated by Bento edge. Do not edit; operator drop-ins live in edge/custom.
# Includes are relative to this file's directory so a candidate generation can
# be validated in place before promotion.
{{- if .ACME}}
load_module /usr/lib/nginx/modules/ngx_http_acme_module.so;
{{- end}}
worker_processes auto;
# Each proxied request holds two descriptors; the default 1024 caps the edge
# far below worker_connections.
worker_rlimit_nofile 65535;
worker_shutdown_timeout 10s;
error_log stderr warn;
pid /run/nginx.pid;

include /etc/bento-edge-custom/main.d/*.conf;

events {
  worker_connections 4096;
  multi_accept on;
}

http {
  # Docker's embedded DNS. Short validity so replaced app containers are
  # re-resolved; app upstreams use variables to force runtime resolution.
  resolver 127.0.0.11 valid=10s ipv6=off;
  resolver_timeout 5s;
{{- if .ACME}}

  acme_shared_zone zone=ngx_acme_shared:10M;
  acme_issuer bento_acme {
    uri {{quote .ACMEURL}};
{{- if .ACMEEmail}}
    contact {{quote .ACMEEmail}};
{{- end}}
    state_path /var/lib/bento-acme/bento_acme;
    accept_terms_of_service;
  }
{{- end}}

  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  types_hash_max_size 4096;
  server_names_hash_bucket_size 128;
  server_tokens off;
  sendfile on;
  tcp_nopush on;
  tcp_nodelay on;
  keepalive_timeout 30s;
  client_body_timeout 60s;
  client_header_timeout 15s;
  send_timeout 60s;
  reset_timedout_connection on;
  client_max_body_size 64m;

  map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
  }

  log_format bento_edge '$remote_addr - [$time_local] "$request" $status $body_bytes_sent '
                        '"$http_referer" "$http_user_agent" rt=$request_time urt=$upstream_response_time '
                        'route=$bento_route host=$host';
  access_log off;

  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_timeout 1d;
  ssl_session_cache shared:SSL:20m;
  # Session resumption uses the shared cache; never-rotated ticket keys would
  # weaken forward secrecy.
  ssl_session_tickets off;
  ssl_buffer_size 4k;

  gzip on;
  gzip_vary on;
  gzip_min_length 1024;
  gzip_comp_level 5;
  gzip_types text/plain text/css text/javascript text/xml application/json application/javascript application/xml image/svg+xml
             application/manifest+json application/wasm font/ttf font/otf application/vnd.ms-fontobject;

  # Shared cache for app static assets (per-app opt-in). Lives on the edge's
  # tmpfs, so it is bounded, never persisted, and emptied on edge restart.
  proxy_cache_path /var/cache/nginx/static levels=1:2 keys_zone=bento_static:16m
                   max_size=192m inactive=60m use_temp_path=off;

  include /etc/bento-edge-custom/http.d/*.conf;

  # Unknown Host/SNI is rejected.
  server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    set $bento_route "-";
    return 404;
  }
  server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
{{- if .HTTP3}}
    listen 443 quic reuseport default_server;
    listen [::]:443 quic reuseport default_server;
{{- end}}
    http2 on;
    server_name _;
    set $bento_route "-";
    ssl_certificate /etc/bento-edge-certs/boot.crt;
    ssl_certificate_key /etc/bento-edge-certs/boot.key;
    return 404;
  }

  include sites/*.conf;
  include /etc/bento-edge-custom/sites.d/*.conf;
}
