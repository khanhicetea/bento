{
  "name": "@bento/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && mkdir -p dist && bun build src/main.tsx --target=browser --minify --outfile=dist/app.js && cp index.html dist/index.html && cp src/app.css dist/app.css",
    "check": "bunx tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@bento/shared": "workspace:*",
    "@orpc/client": "1.15.0",
    "@orpc/contract": "1.15.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "wouter": "3.7.1"
  },
  "devDependencies": {
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7"
  }
}
