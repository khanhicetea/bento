{
  "name": "@bento/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && mkdir -p dist && bun build src/main.tsx --target=browser --minify --outfile=dist/app.js && bunx tailwindcss -i src/app.css -o dist/app.css --minify && cp -R public/. dist/ && cp index.html dist/index.html",
    "check": "bunx tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@tanstack/react-query": "5.102.0",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.33.0",
    "radix-ui": "1.6.7",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "shadcn": "4.19.0",
    "simple-icons": "16.33.0",
    "tailwind-merge": "3.3.1",
    "tw-animate-css": "1.4.0",
    "wouter": "3.7.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.1.12",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "tailwindcss": "4.1.12"
  }
}
